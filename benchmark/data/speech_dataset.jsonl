{"record_type": "speech_example", "audio_example_id": "TM_A16", "speaker_id": "SPK_EN_Samantha", "audio_file_path": "benchmark/audio/en/TM_A16.wav", "transcript": "We now have four-month-old mice that are non-diabetic, that used to be diabetic, he added.", "transcript_language": "en", "sample_rate_hz": 16000, "channel_count": 1, "duration_seconds": 6.471, "speech_start_time": 0.2, "speech_end_time": 6.071, "internal_pause_annotations": [{"pause_start_sec": 3.047, "pause_end_sec": 3.797, "duration_sec": 0.75, "pause_type": "thinking_pause"}], "reference_translation_ids": ["TM_G25"], "recording_source": "tollmatcher_human_recorded", "audio_license_or_permission": "CC-BY-4.0", "annotation_status": "praat_timestamped_verified"}
