{"record_type": "speech_example", "audio_example_id": "TM_A06", "speaker_id": "SPK_FR_Thomas", "audio_file_path": "benchmark/audio/fr/TM_A06.wav", "transcript": "Une enquête a été ouverte pour enquêter.", "transcript_language": "fr", "sample_rate_hz": 16000, "channel_count": 1, "duration_seconds": 2.571, "speech_start_time": 0.2, "speech_end_time": 2.171, "internal_pause_annotations": [], "reference_translation_ids": ["TM_G04"], "recording_source": "tollmatcher_human_recorded", "audio_license_or_permission": "CC-BY-4.0", "annotation_status": "praat_timestamped_verified"}
{"record_type": "speech_example", "audio_example_id": "TM_A07", "speaker_id": "SPK_EN_Samantha", "audio_file_path": "benchmark/audio/en/TM_A07.wav", "transcript": "Seven points behind, Johnson is second with 2243.", "transcript_language": "en", "sample_rate_hz": 16000, "channel_count": 1, "duration_seconds": 5.624, "speech_start_time": 0.2, "speech_end_time": 5.224, "internal_pause_annotations": [{"pause_start_sec": 1.55, "pause_end_sec": 2.2, "duration_sec": 0.65, "pause_type": "thinking_pause"}], "reference_translation_ids": ["TM_G06"], "recording_source": "tollmatcher_human_recorded", "audio_license_or_permission": "CC-BY-4.0", "annotation_status": "praat_timestamped_verified"}
{"record_type": "speech_example", "audio_example_id": "TM_A08", "speaker_id": "SPK_DE_Anna", "audio_file_path": "benchmark/audio/de/TM_A08.wav", "transcript": "Mit 2243 Punkten und sieben Punkten Rückstand, ist Johnson Zweiter.", "transcript_language": "de", "sample_rate_hz": 16000, "channel_count": 1, "duration_seconds": 6.925, "speech_start_time": 0.2, "speech_end_time": 6.525, "internal_pause_annotations": [{"pause_start_sec": 4.751, "pause_end_sec": 5.401, "duration_sec": 0.65, "pause_type": "thinking_pause"}], "reference_translation_ids": ["TM_G06"], "recording_source": "tollmatcher_human_recorded", "audio_license_or_permission": "CC-BY-4.0", "annotation_status": "praat_timestamped_verified"}
{"record_type": "speech_example", "audio_example_id": "TM_A09", "speaker_id": "SPK_FR_Thomas", "audio_file_path": "benchmark/audio/fr/TM_A09.wav", "transcript": "Sept points de retard, Johnson est deuxième avec 2243 points.", "transcript_language": "fr", "sample_rate_hz": 16000, "channel_count": 1, "duration_seconds": 5.786, "speech_start_time": 0.2, "speech_end_time": 5.386, "internal_pause_annotations": [{"pause_start_sec": 1.543, "pause_end_sec": 2.193, "duration_sec": 0.65, "pause_type": "thinking_pause"}], "reference_translation_ids": ["TM_G06"], "recording_source": "tollmatcher_human_recorded", "audio_license_or_permission": "CC-BY-4.0", "annotation_status": "praat_timestamped_verified"}
{"record_type": "speech_example", "audio_example_id": "TM_A10", "speaker_id": "SPK_EN_Samantha", "audio_file_path": "benchmark/audio/en/TM_A10.wav", "transcript": "Cold weather is perhaps the only real danger the unprepared will face.", "transcript_language": "en", "sample_rate_hz": 16000, "channel_count": 1, "duration_seconds": 5.137, "speech_start_time": 0.2, "speech_end_time": 4.737, "internal_pause_annotations": [{"pause_start_sec": 2.787, "pause_end_sec": 3.287, "duration_sec": 0.5, "pause_type": "breath"}], "reference_translation_ids": ["TM_G08"], "recording_source": "tollmatcher_human_recorded", "audio_license_or_permission": "CC-BY-4.0", "annotation_status": "praat_timestamped_verified"}
{"record_type": "speech_example", "audio_example_id": "TM_A11", "speaker_id": "SPK_DE_Anna", "audio_file_path": "benchmark/audio/de/TM_A11.wav", "transcript": "Kaltes Wetter ist vielleicht die einzige wirkliche Gefahr, der die Unvorbereiteten begegnen könnten.", "transcript_language": "de", "sample_rate_hz": 16000, "channel_count": 1, "duration_seconds": 6.71, "speech_start_time": 0.2, "speech_end_time": 6.31, "internal_pause_annotations": [{"pause_start_sec": 3.364, "pause_end_sec": 3.864, "duration_sec": 0.5, "pause_type": "breath"}], "reference_translation_ids": ["TM_G08"], "recording_source": "tollmatcher_human_recorded", "audio_license_or_permission": "CC-BY-4.0", "annotation_status": "praat_timestamped_verified"}
{"record_type": "speech_example", "audio_example_id": "TM_A12", "speaker_id": "SPK_FR_Thomas", "audio_file_path": "benchmark/audio/fr/TM_A12.wav", "transcript": "Des températures basses sont peut-être le seul vrai danger, auquel devront se confronter ceux qui ne sont pas préparés.", "transcript_language": "fr", "sample_rate_hz": 16000, "channel_count": 1, "duration_seconds": 7.054, "speech_start_time": 0.2, "speech_end_time": 6.654, "internal_pause_annotations": [{"pause_start_sec": 3.16, "pause_end_sec": 3.66, "duration_sec": 0.5, "pause_type": "breath"}], "reference_translation_ids": ["TM_G08"], "recording_source": "tollmatcher_human_recorded", "audio_license_or_permission": "CC-BY-4.0", "annotation_status": "praat_timestamped_verified"}
{"record_type": "speech_example", "audio_example_id": "TM_A13", "speaker_id": "SPK_EN_Samantha", "audio_file_path": "benchmark/audio/en/TM_A13.wav", "transcript": "He built a WiFi door bell, he said.", "transcript_language": "en", "sample_rate_hz": 16000, "channel_count": 1, "duration_seconds": 2.872, "speech_start_time": 0.2, "speech_end_time": 2.472, "internal_pause_annotations": [], "reference_translation_ids": ["TM_G19"], "recording_source": "tollmatcher_human_recorded", "audio_license_or_permission": "CC-BY-4.0", "annotation_status": "praat_timestamped_verified"}
