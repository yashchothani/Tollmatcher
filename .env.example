# TollMatcher Speech Translation Lab - Environment Configuration
# Copy this file to .env and adjust variables as needed

# Web Server Configuration
HOST=127.0.0.1
PORT=8000

# Inference Engine Configuration
# Available modes: "auto", "local", "benchmark"
TOLLMATCHER_MODE=auto

# Whisper ASR Configuration (used when faster_whisper is available)
WHISPER_MODEL_SIZE=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_NUM_WORKERS=1

# Translation Model Configuration
# "argos" (offline ctranslate2), "marian" (HuggingFace MarianMT), or "reference"
TRANSLATION_BACKEND=argos

# Audio Hardware Devices (Raspberry Pi ALSA soundcards)
# Leave default or override if USB sound card identifier changes
CONFIRM_AUDIO_DEVICE=sysdefault:CARD=USB
GUEST_TTS_DEVICE=sysdefault:CARD=USB
USER_TTS_DEVICE=sysdefault:CARD=Device
